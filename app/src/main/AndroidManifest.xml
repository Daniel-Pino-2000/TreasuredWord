<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission is required to fetch remote data -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Used to check connectivity before starting a bulk version download -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Required on API 33+ before posting the daily verse reminder notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Lets BootCompletedReceiver re-arm the daily verse jobs after a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Android 11+ hides other apps unless asked for: lets utils/ExternalLinks.kt find a browser
         that supports Custom Tabs before falling back to a plain link. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".BibleApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BibleApp"
        tools:targetApi="31">
        <!-- configChanges: a language change updates the running activity instead of recreating
             it, which tore the window down and showed black until the new one drew (#34). Compose
             recomposes with the new configuration; MainActivity.onConfigurationChanged covers
             what's built outside composition. screenLayout too: it holds a layout-direction
             field, which the first switch away from "System default" changes along with the
             language (when the system creates the app's own configuration), so without it that
             switch still recreated the activity and flashed black (#89). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_short_name"
            android:configChanges="locale|layoutDirection|screenLayout"
            android:theme="@style/Theme.BibleApp.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Below Android 13, AppCompat stores the in-app language choice itself and re-applies
             it on launch (Android 13+ keeps it in the system instead and syncs it over once). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- exported="true": required for the system to be able to deliver these
             protected broadcasts, which only the OS itself is allowed to send. -->
        <receiver
            android:name=".receiver.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>