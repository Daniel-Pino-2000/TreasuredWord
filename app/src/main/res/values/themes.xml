<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- AppCompat, because MainActivity is an AppCompatActivity (per-app language below Android 13).
         Compose draws everything, including dark mode, so this only sets the window's starting look. -->
    <style name="Theme.BibleApp" parent="Theme.AppCompat.Light.NoActionBar" />

    <!-- Startup screen (#135), through core-splashscreen so Android 7–11 show the icon too, not
         a blank window. The launcher icon's book on its espresso circle with the app's name under
         it (#143), then the app's theme. No system icon background: the circle is part of the
         icon, which gets the larger 288 dp area that way so the name fits. Splash follows the
         phone's light/dark; SplashLight and SplashDark are the fixed versions MainActivity picks
         on Android 13+ to follow the app's own theme setting. -->
    <style name="Theme.BibleApp.SplashBase" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.BibleApp</item>
    </style>
    <style name="Theme.BibleApp.SplashLight" parent="Theme.BibleApp.SplashBase">
        <item name="windowSplashScreenBackground">@color/splash_background_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_light</item>
    </style>
    <style name="Theme.BibleApp.SplashDark" parent="Theme.BibleApp.SplashBase">
        <item name="windowSplashScreenBackground">@color/splash_background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_dark</item>
    </style>
    <style name="Theme.BibleApp.Splash" parent="Theme.BibleApp.SplashLight" />

    <!-- The same three for each other color theme (#244); ThemePalette picks one on Android 13+. -->
    <style name="Theme.BibleApp.SplashInkLight" parent="Theme.BibleApp.SplashBase">
        <item name="windowSplashScreenBackground">@color/splash_background_ink_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_light</item>
    </style>
    <style name="Theme.BibleApp.SplashInkDark" parent="Theme.BibleApp.SplashBase">
        <item name="windowSplashScreenBackground">@color/splash_background_ink_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_dark</item>
    </style>
    <style name="Theme.BibleApp.SplashInk" parent="Theme.BibleApp.SplashInkLight" />
    <style name="Theme.BibleApp.SplashGraphiteLight" parent="Theme.BibleApp.SplashBase">
        <item name="windowSplashScreenBackground">@color/splash_background_graphite_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_light</item>
    </style>
    <style name="Theme.BibleApp.SplashGraphiteDark" parent="Theme.BibleApp.SplashBase">
        <item name="windowSplashScreenBackground">@color/splash_background_graphite_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_dark</item>
    </style>
    <style name="Theme.BibleApp.SplashGraphite" parent="Theme.BibleApp.SplashGraphiteLight" />
    <style name="Theme.BibleApp.SplashSageLight" parent="Theme.BibleApp.SplashBase">
        <item name="windowSplashScreenBackground">@color/splash_background_sage_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_light</item>
    </style>
    <style name="Theme.BibleApp.SplashSageDark" parent="Theme.BibleApp.SplashBase">
        <item name="windowSplashScreenBackground">@color/splash_background_sage_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_dark</item>
    </style>
    <style name="Theme.BibleApp.SplashSage" parent="Theme.BibleApp.SplashSageLight" />
    <style name="Theme.BibleApp.SplashSlateLight" parent="Theme.BibleApp.SplashBase">
        <item name="windowSplashScreenBackground">@color/splash_background_slate_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_light</item>
    </style>
    <style name="Theme.BibleApp.SplashSlateDark" parent="Theme.BibleApp.SplashBase">
        <item name="windowSplashScreenBackground">@color/splash_background_slate_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_dark</item>
    </style>
    <style name="Theme.BibleApp.SplashSlate" parent="Theme.BibleApp.SplashSlateLight" />
    <style name="Theme.BibleApp.SplashRoseLight" parent="Theme.BibleApp.SplashBase">
        <item name="windowSplashScreenBackground">@color/splash_background_rose_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_light</item>
    </style>
    <style name="Theme.BibleApp.SplashRoseDark" parent="Theme.BibleApp.SplashBase">
        <item name="windowSplashScreenBackground">@color/splash_background_rose_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_dark</item>
    </style>
    <style name="Theme.BibleApp.SplashRose" parent="Theme.BibleApp.SplashRoseLight" />
</resources>
