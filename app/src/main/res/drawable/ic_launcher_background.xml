<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon background (#110): espresso, a touch lighter at the top. The gradient runs across
     the 72 dp a launcher actually shows (18..90), not the full 108 dp layer, so it stays visible. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0H108V108H0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="18"
                android:endX="0"
                android:endY="90">
                <item android:offset="0" android:color="#FF2E251B" />
                <item android:offset="1" android:color="#FF15110D" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
