<?xml version="1.0" encoding="utf-8"?>
<!-- The "Verse to memorize" widget's picker preview on Android 12+ (#364), drawn like the daily
     verse widget's (#245): the real title and hint button, and placeholder lines for the passage
     and its reference, which come from the person's own list. Widgets only allow some view
     classes (FrameLayout, ImageView, TextView...), not a plain View. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_daily_verse_preview_background"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/widget_memorize_title"
            android:textColor="@color/widget_preview_title"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_hide_words"
            android:tint="@color/widget_preview_title"
            android:layout_width="20dp"
            android:layout_height="20dp"
            tools:ignore="ContentDescription,UseAppTint" />
    </LinearLayout>

    <ImageView
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_daily_verse_preview_bar"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="10dp"
        android:alpha="0.45"
        tools:ignore="ContentDescription" />

    <ImageView
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_daily_verse_preview_bar"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="8dp"
        android:alpha="0.45"
        tools:ignore="ContentDescription" />

    <ImageView
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_daily_verse_preview_bar"
        android:layout_width="120dp"
        android:layout_height="10dp"
        android:layout_marginTop="8dp"
        android:alpha="0.45"
        tools:ignore="ContentDescription" />

    <!-- Pushes the reference line to the bottom; a plain Space isn't allowed in widgets. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        tools:ignore="UselessLeaf" />

    <ImageView
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_daily_verse_preview_bar"
        android:layout_width="80dp"
        android:layout_height="8dp"
        android:alpha="0.8"
        tools:ignore="ContentDescription" />
</LinearLayout>
