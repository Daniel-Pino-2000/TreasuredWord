<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 7-8.1 (Android 12+ reads data_extraction_rules.xml, and
   9-11 read xml-v28/backup_rules.xml). See data_extraction_rules.xml for why each file is
   in or out. These versions can't tell cloud backup from device transfer, so the Bible DB
   stays out: it would push the backup past the 25 MB cloud limit and drop all of it.
-->
<full-backup-content>
    <include domain="sharedpref" path="bible_prefs.xml" />
    <include domain="sharedpref" path="app_language.xml" />
</full-backup-content>
