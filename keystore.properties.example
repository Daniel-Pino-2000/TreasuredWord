# Copy this file to keystore.properties (same folder, the repo root) and fill in your own values.
# keystore.properties is git-ignored: never commit it, and never put the key file inside the repo.
# See docs/release.md.
#
# Path to the upload key. Use forward slashes, even on Windows.
storeFile=C:/Users/YOUR_NAME/keys/treasuredword-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
